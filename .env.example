# Copy to .env and adjust as needed.
AI_SERVER_PORT=5001
REDIS_PORT=6380

# Monitoring profile (docker compose --profile monitoring up -d).
LOKI_PORT=3100
GRAFANA_PORT=3001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Where the app ships audit events. Empty disables audit export, which is what a
# plain `docker compose up` (no Loki running) wants. Uncomment the second line
# for the monitoring profile; test/e2e/suite.sh refuses to run without it.
OTEL_EXPORTER_OTLP_ENDPOINT=
#OTEL_EXPORTER_OTLP_ENDPOINT=http://loki:3100/otlp
