# Copy to .env and adjust as needed.
AI_SERVER_PORT=5001
REDIS_PORT=6380

# Monitoring profile (docker compose --profile monitoring up -d).
LOKI_PORT=3100
GRAFANA_PORT=3001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Where the app ships audit events. Leave empty to disable audit export, which is
# what a plain `docker compose up` (no Loki running) wants. Set it to the value
# below when running the monitoring profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://loki:3100/otlp
